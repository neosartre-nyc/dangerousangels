---
import "../styles/global.css"
import Hero from "../components/Hero.astro";
---

<div id="loader-container" class="relative w-full h-[80lvh] bg-gray-900 overflow-hidden">

  <!-- Video stays on top initially -->
  <video
    id="loading-video"
    autoplay
    muted
    loop
    playsinline
    class="absolute inset-0 w-full h-full object-cover z-10 transition-opacity duration-500"
  >
    <source src="/video/loading-video.mp4" type="video/mp4">
    Your browser does not support the video tag.
  </video>

  <!-- Hero starts completely invisible -->
  <div
    id="static-content"
    class="absolute inset-0 z-0 opacity-0 pointer-events-none transition-opacity duration-500"
  >
    <Hero />
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const video = document.getElementById('loading-video');
    const staticContent = document.getElementById('static-content');

    const loadingDuration = 4700; // adjust as needed

    // Ensure video tries to play
    video?.play().catch(() => {
      console.warn("Autoplay failed.");
    });

    setTimeout(() => {
      // Fade video out
      video.style.opacity = '0';

      // After the CSS transition finishes…
      setTimeout(() => {
        video.style.display = 'none';          // fully remove it
        video.style.zIndex = '0';

        // Reveal Hero
        staticContent.classList.remove('opacity-0', 'pointer-events-none');
        staticContent.classList.add('opacity-100', 'z-10');
      }, 500); // must match duration-500
    }, loadingDuration);
  });
</script>
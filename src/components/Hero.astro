---
import "../styles/global.css";
import Button from "../components/PairButton.astro"
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hero</title>
  </head>
  <div
    class="w-full h-[80lvh] bg-cover bg-top"
    style=`background-image: url('/images/dac-angels.webp')`
  >
    <section
      class="animate-fade-in [animation-delay:3s] [animation-fill-mode:backwards] pt-28 px-10 md:px-20 lg:px-44 not-last:bg-transparent text-center text-dacSage-50 animate-delayed-7s text-shadow-lg  text-shadow-dacSage-950"
    >
      <h1
        class="font-serif  text-2xl md:text-4xl lg:text-6xl xl:8xl pb-4"
      >Do your patrons feel like indifferent consumers or engaged devotees?
      </h1>
        <h2 class="font-medium text-lg md:text-2xl xl:text-4xl py-2">Branding is not a fixed message, but a social negotiation between identity, belonging, and the norms of the field.</h2>
        <div class="font-thin pt-2.5 leading-relaxed text-med md:text-lg text-left pl-20 mx-auto max-w-3xl">
          <p>Unleash Opportunities:</p>
          <ul class="list-inside list-disc marker:text-dacBlue-500">
            <li>Leverage existing social networks and relationships within your community.</li>
            <li>Develop effective communication and mobilization strategies.</li>
            <li>Institute substantiated, adaptable, flexible user-centered guidelines.</li>
          </ul>
        </div>
    </section>
    <section class="absolute inset-x-0 bottom-2 flex gap-4 justify-center">
      <Button />
    </section>
  </div>

</html>

<script>
  const button = document.getElementById('book-now');
  
  button.addEventListener('click', () => {
    const url = 'https://calendar.proton.me/bookings#VEwY-mViucEDbgPhbzRaDCcZRsWnPwskpR42Pfs9EaA=';
    const windowFeatures = 'width=600,height=700,resizable=yes,scrollbars=yes';
    
    window.open(url, 'ProtonBooking', windowFeatures);
  });
</script>




---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hero</title>
  </head>
  <div
    class="w-full h-[80lvh] bg-cover bg-top"
    style=`background-image: url('/images/dac-angels.webp')`
  >
    <section
      class="animate-fade-in [animation-delay:5s] [animation-fill-mode:backwards] p-44 not-last:bg-transparent text-center text-white animate-delayed-7s"
    >
      <h1
        class="font-serif text-dacBlue-50 text-shadow-dacRed-800 text-shadow-md text-4xl sm:text-5xl xl:text-6xl pb-4"
      >
        Dangerous Angels Creative
      </h1>
      <h2 class="font-medium text-lg sm:text-xl xl:text-2xl py-2">
        Design the Meaning
      </h2>
      <p class="font-thin leading-tight">natalie reuchlein</p>
      <p class="font-thin leading-tight">designer</p>
      <p class="font-thin leading-tight">nyc</p>
    </section>
  </div>


</html>

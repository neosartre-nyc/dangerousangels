---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hero</title>
  </head>
  <div
    class="w-full h-[80lvh] bg-cover bg-top"
    style=`background-image: url('/images/dac-angels.webp')`
  >
    <section
      class="animate-fade-in [animation-delay:5s] [animation-fill-mode:backwards] pt-44 px-10 md:px-20 lg:px-44 not-last:bg-transparent text-center text-dacSage-50 animate-delayed-7s text-shadow-lg  text-shadow-dacSage-950"
    >
      <h1
        class="font-serif  text-xl md:text-4xl lg:text-6xl xl:8xl pb-4"
      >Do your patrons feel like consumers or devotees?
      </h1>
        <h2 class="font-medium text-sm md:text-2xl xl:text-4xl py-2">Branding is not a fixed message, but a social negotiation between identity, belonging, and the norms of the field.</h2>
        <div class="font-thin leading-tight">
          <a class="hover:text-2xl" href="/resume">natalie reuchlein</a>
          <p>design the meaning</p>
          <p>nyc</p>
        </div>
      <div class="absolute inset-x-0 bottom-2 flex gap-4 justify-center">
            <button
            type="button"
            class="px-1 md:px-20 py-4 rounded-xl bg-dacSage-800 text-white text-1xl hover:scale-110 hover:bg-dacRed-800"
            onclick="window.location.href='/product'"
            >Services
          </button>            
            <button
            type="button"
            class="px-1 md:px-20 py-4 rounded-xl bg-dacBlue-800 text-white text-1xl hover:scale-110 hover:bg-dacRed-800"
            onclick="window.location.href='/sociology'"
            >Cult\(ure)
          </button>            
          </div>
    </section>
  </div>

</html>

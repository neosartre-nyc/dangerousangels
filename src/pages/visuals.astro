---
import * as Content from "../content/2026-10-11-visualcommunication.md";
const compiled = await Content.compiledContent();
import Layout from "../layouts/LayoutFish.astro";
---
    <Layout>
      <section class="py-8 px-8 md:px-16 lg:px-20 xl:px-40 text-white">
        <h1 class="font-serif text-3xl">{Content.frontmatter.title}</h1>
        <div class="prose leading-relaxed">
          <Fragment set:html={compiled} />
        </div>
      </section>
      <div class="mb-5 flex justify-center">
        <button
          type="button"
          class="px-6 py-4 rounded-xl bg-dacSage-400 text-white text-1xl hover:scale-110 hover:bg-dacRed-800"
          onclick="window.location.href='/sociology'"
          >The Sociology Of Design</button
        >
      </div>
    </Layout>

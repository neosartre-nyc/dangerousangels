<html lang="en">
<body class="bg-dacSage-50 min-h-screen font-sans text-black">
  <div class="max-w-7xl mx-auto px-6 py-12">
    <!-- Main Title -->
    <h1 class="text-5xl md:text-[3.2rem] font-serif font-bold leading-tight mb-16 tracking-tight">
      Symbols construct social reality.
    </h1>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <!-- LEFT COLUMN -->
      <div class="flex flex-col gap-12">
        <!-- Diagram Card -->
        <div class="relative w-full aspect-4/3 flex items-center justify-center">
          <!-- Center circle (eye) -->
          <div class="relative w-28 h-28 md:w-36 md:h-36">
            <!-- Outer ring -->
            <div class="absolute inset-0 rounded-full border-8 border-black" />
            <!-- Inner white circle -->
            <div class="absolute inset-2 rounded-full bg-white" />
            <!-- Pupil -->
            <div class="absolute top-[20%] left-[26%] w-1/3 h-1/3 rounded-full bg-black" />
          </div>

          <!-- Radiating lines and labels -->
          <!-- TOP - VALUES -->
          <div class="absolute -top-3 flex flex-col items-center">
            <span class="text-xs font-sans text-dacRed-50 tracking-widest uppercase mb-2">VALUES</span>
            <div class="w-px h-6 bg-black"></div>
          </div>

          <!-- BOTTOM - BELONGING -->
          <div class="absolute -bottom-3 flex flex-col items-center">
            <span class="text-xs font-sans text-dacRed-50 tracking-widest uppercase mb-2">BELONGING</span>
            <div class="w-px h-6 bg-black"></div>
          </div>

          <!-- LEFT - IDENTITY -->
          <div class="absolute -left-2.5 flex items-center">
            <span class="text-xs font-sans text-dacRed-50 tracking-widest uppercase pr-4">IDENTITY</span>
            <div class="h-px w-6 bg-black"></div>
          </div>

          <!-- RIGHT - STATUS -->
          <div class="absolute -right-2.5 flex items-center justify-end">
            <span class="text-xs font-sans text-dacRed-50 tracking-widest uppercase pl-4">STATUS</span>
            <div class="h-px w-6 bg-black"></div>
          </div>

          <!-- Diagonal lines -->
          <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 400 300">
            <!-- Top-left to center -->
            <line x1="200" y1="75" x2="140" y2="140" stroke="#333" stroke-width="1.5" opacity="0.2" />
            <!-- Top-right to center -->
            <line x1="200" y1="75" x2="260" y2="140" stroke="#333" stroke-width="1.5" opacity="0.2" />
            <!-- Bottom-left to center -->
            <line x1="200" y1="225" x2="140" y2="160" stroke="#333" stroke-width="1.5" opacity="0.2" />
            <!-- Bottom-right to center -->
            <line x1="200" y1="225" x2="260" y2="160" stroke="#333" stroke-width="1.5" opacity="0.2" />
          </svg>

          <!-- Red dots -->
          <div class="absolute top-[16%] w-2.5 h-2.5 rounded-full bg-dacRed-500" style="top: 16%"></div>
          <div class="absolute bottom-[18%] w-2.5 h-2.5 rounded-full bg-dacRed-500" style="bottom: 18%"></div>
          <div class="absolute left-[8%] w-2.5 h-2.5 rounded-full bg-dacRed-500" style="left: 8%"></div>
          <div class="absolute right-[10%] w-2.5 h-2.5 rounded-full bg-dacRed-500" style="right: 10%"></div>
        </div>

        <!-- Text Block -->
        <div class="space-y-6">
          <p class="text-xl md:text-[1.75rem] font-serif italic leading-relaxed">
            A logo is also a claim about who belongs.
          </p>
          <p class="text-sm md:text-base text-gray-600 leading-relaxed max-w-md">
            Branding converts abstract ideals into marks, narratives, and rituals that communities interpret and internalize.
          </p>
        </div>
      </div>

      <!-- RIGHT COLUMN -->
      <div class="flex flex-col gap-0">
        <!-- Separator line above content -->
        <div class="w-full h-px bg-gray-400 mb-8"></div>

        <!-- Represent Section -->
        <div class="flex flex-col gap-3 mb-8">
          <span class="text-xs font-sans text-dacRed-500 tracking-widest uppercase">Represent</span>
          <h2 class="text-2xl md:text-[1.5rem] font-serif font-bold leading-snug">Values made visible</h2>
          <p class="text-sm md:text-base text-gray-600 leading-relaxed max-w-lg">
            A symbol condenses a community's ideals into a single, recognisable mark.
          </p>
        </div>

        <!-- Separator -->
        <div class="w-full h-px bg-gray-400 mb-8"></div>

        <!-- Shape Section -->
        <div class="flex flex-col gap-3 mb-8">
          <span class="text-xs font-sans text-dacRed-500 tracking-widest uppercase">Shape</span>
          <h2 class="text-2xl md:text-[1.5rem] font-serif font-bold leading-snug">Self-understanding and group identity</h2>
          <p class="text-sm md:text-base text-gray-600 leading-relaxed max-w-lg">
            Symbols actively shape how individuals understand themselves within larger cultural formations.
          </p>
        </div>

        <!-- Separator -->
        <div class="w-full h-px bg-gray-400 mb-8"></div>

        <!-- Construct Section -->
        <div class="flex flex-col gap-3">
          <span class="text-xs font-sans text-dacRed-500 tracking-widest uppercase">Construct</span>
          <h2 class="text-2xl md:text-[1.5rem] font-serif font-bold leading-snug">Constructing a shared social world</h2>
          <p class="text-sm md:text-base text-gray-600 leading-relaxed max-w-lg">
            Symbols do not merely represent — they participate in constructing the social world people inhabit.
          </p>
        </div>

        <!-- Bottom separator -->
        <div class="w-full h-px bg-gray-400 mt-8"></div>
      </div>
    </div>
  </div>

  <script src="https://unpkg.com/astro@0.27.5/dist/main.js"></script>
</body>


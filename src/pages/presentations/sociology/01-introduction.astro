---
import Layout from "../../../layouts/Layout.astro";
---
<Layout title="Audience" theme="default">
      <body class="bg-dacSage-100 min-h-screen font-sans text-dacBlue-950 antialiased">
        <div class="max-w-350  mx-auto px-6 py-8 md:py-12">
        
          <!-- ════════════════ MAIN SLIDE CARD ════════════════ -->
          <section class="bg-white rounded-lg shadow-sm mb-10">
      
            <!-- Top row: Title + Description -->
            <div class="flex flex-col md:flex-row gap-12 items-start">
      
              <!-- Left: Title block -->
              <div class="w-full md:w-[52%]">
                <!-- Category tag -->
                <p class="text-xs tracking-[0.2em] uppercase text-dacRed-700 mb-4">
                  Branding / Identity / Social Relations
                </p>
      
                <!-- Main title -->
                <h1 class="text-5xl md:text-[80px] leading-none font-bold tracking-tight text-dacBlue-950">
                  The Sociology<br />Of Design
                </h1>
      
                <!-- Subtitle -->
                <p class="text-lg italic font-light text-dacSage-400 mt-4">
                  Meaning, Identity, and Social Relations
                </p>
              </div>
      
              <!-- Right: Description block -->
              <div class="w-full md:w-[48%] flex items-start">
                <!-- Decorative dash -->
                <div class="hidden md:block w-12 h-0.75 bg-dacRed-700 mb-8"></div>
      
                <div>
                  <p class="text-lg md:text-xl leading-relaxed text-dacBlue-950">
                    A way to see the social life<br />inside things.
                  </p>
      
                  <p class="text-sm leading-relaxed text-dacSage-400 mt-3">
                    The unwritten rules shape our lives in so many ways and go undefined,
                    ineffable, and overlooked.
                  </p>
                </div>
              </div>
            </div>
          </section>
      
          <!-- ════════════════ LOWER DIAGRAM CARD ════════════════ -->
          <section class="bg-white rounded-lg shadow-sm mb-10">
      
            <div class="grid grid-cols-1 md:grid-cols-[28%_auto_28%] gap-x-10 gap-y-6 items-center">
      
              <!-- Left: Text -->
              <div class="md:col-span-1 hidden md:block">
                <p class="text-lg md:text-xl font-medium leading-relaxed text-dacBlue-950">
                  Branding as a sociological<br />practice.
                </p>
      
                <p class="text-sm leading-relaxed text-dacSage-400 mt-3">
                  Organizations and communities use branding to articulate identity,
                  negotiate belonging, and distinguish themselves within social fields.
                </p>
              </div>
      
              <!-- Center: Social Existence circle -->
              <div class="flex flex-col items-center md:col-span-1">
                <div class="w-50 h-50 md:w-60 md:h-60 rounded-full border-2 border-stone-300 flex items-center justify-center">
                  <p class="text-sm md:text-base font-medium text-dacBlue-950">
                    Social<br />Existence
                  </p>
                </div>
      
                <!-- Arrows (hidden on mobile, shown inline with text) -->
                <div class="hidden md:flex items-center gap-0 mt-4">
                  <!-- Top arrow -->
                  <div class="flex items-center gap-2 text-xs tracking-wider uppercase text-dacSage-400">
                    <svg width="28" height="6" viewBox="0 0 24 6">
                      <path d="M0 3l8 3 16-6" stroke="currentColor" stroke-width="2.5"
                            stroke-linecap="round" fill="none" class="text-dacRed-700" />
                    </svg>
                    <span>Values become forms</span>
                  </div>
      
                  <!-- Bottom arrow -->
                  <div class="flex items-center gap-2 text-xs tracking-wider uppercase text-dacSage-400">
                    <span>Forms shape possibilities</span>
                    <svg width="28" height="6" viewBox="0 0 24 6">
                      <path d="M24 3l-8-3-16 6" stroke="currentColor" stroke-width="2.5"
                            stroke-linecap="round" fill="none" class="text-dacRed-700" />
                    </svg>
                  </div>
                </div>
      
                <!-- Mobile arrows (vertical) -->
                <div class="md:hidden flex flex-col items-center gap-2 mt-4">
                  <div class="flex items-center gap-1 text-xs tracking-wider uppercase text-dacSage-400">
                    <svg width="28" height="6" viewBox="0 0 24 6">
                      <path d="M0 3l8 3 16-6" stroke="currentColor" stroke-width="2.5"
                            stroke-linecap="round" fill="none" class="text-dacRed-700" />
                    </svg>
                    <span>Values become forms</span>
                  </div>
      
                  <!-- Right circle -->
                  <div class="w-35 h-35 rounded-full border-2 border-stone-300 flex items-center justify-center">
                    <p class="text-sm font-medium text-dacBlue-950">Branding</p>
                  </div>
      
                  <div class="flex items-center gap-1 text-xs tracking-wider uppercase text-dacSage-400">
                    <span>Forms shape possibilities</span>
                    <svg width="28" height="6" viewBox="0 0 24 6">
                      <path d="M24 3l-8-3-16 6" stroke="currentColor" stroke-width="2.5"
                            stroke-linecap="round" fill="none" class="text-dacRed-700" />
                    </svg>
                  </div>
                </div>
              </div>
      
              <!-- Right: Branding circle (desktop only) -->
              <div class="hidden md:block">
                <div class="w-50 h-50 md:w-60 md:h-60 rounded-full border-2 border-stone-300 flex items-center justify-center">
                  <p class="text-sm md:text-base font-medium text-dacBlue-950">Branding</p>
                </div>
              </div>
      
            </div>
          </section>
      
        </div>
      </body>
    </Layout>
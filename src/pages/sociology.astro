---
import * as Content from "../content/2026-10-23-sociologyOfDesign.md";
const compiled = await Content.compiledContent();
import "../styles/global.css";
import Layout from "../layouts/LayoutBlue.astro";
---

<Layout>
  <h1 class="py-8 font-serif text-center text-5xl text-white">The Cult(ure) Presentation</h1>
  
  <!-- Responsive container wrapper -->
  <div class="flex justify-center px-4 py-8">
    <div class="w-full max-w-4xl aspect-video overflow-hidden rounded-lg border border-white/10 shadow-xl bg-black/20">
      <iframe 
        class="w-full h-full border-0"
        src="https://embed.figma.com/deck/i2AQCYjuGbKOfdqpAGrQjl/The-Sociology-of-Design-version2?node-id=1-54&scaling=scale-down-width&content-scaling=fixed&page-id=0%3A1&embed-host=share"
        allowfullscreen
        loading="lazy"
        title="The Sociology of Design Presentation"
      ></iframe>
    </div>
  </div>

  <section class="py-8 px-8 text-white md:px-16 lg:px-20 xl:px-40">
    <h2 class="font-serif text-3xl mb-6">{Content.frontmatter.title}</h2>
    <div class="prose prose-invert max-w-none leading-relaxed">
      <Fragment set:html={compiled} />
    </div>
  </section>
</Layout>
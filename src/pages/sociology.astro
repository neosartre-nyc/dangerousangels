---
import * as Content from "../content/2026-10-23-sociologyOfDesign.md";
const compiled = await Content.compiledContent();
import "../styles/global.css";
import Layout from "../layouts/LayoutBlue.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sociology</title>
  </head>
    <Layout>
      <h1 class="py-8 font-serif text-center text-5xl text-white">The Cult\(ure) Presentation</h1>
        <div class="flex justify-center py-8">
          <iframe 
            class="border border-white/10 rounded-lg shadow-xl overflow-hidden w-full max-w-225 aspect-video"
            src="https://embed.figma.com/deck/i2AQCYjuGbKOfdqpAGrQjl/The-Sociology-of-Design-version2?node-id=1-54&scaling=min-zoom&content-scaling=fixed&page-id=0%3A1&embed-host=share"
            allowfullscreen
          ></iframe>
        </div>
        <section class="py-8 px-8 text-white md:px-16 lg:px-20 xl:px-40">
        <h1 class="font-serif text-3xl">{Content.frontmatter.title}</h1>
        <div class="prose leading-relaxed">
          <Fragment set:html={compiled} />
        </div>
      </section>
    </Layout>
</html>

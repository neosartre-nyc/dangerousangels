---
import * as Content from "../content/2026-09-27-brandrelationship.md";
const compiled = await Content.compiledContent();
import Layout from "../layouts/Layout.astro";
---
    <Layout>
      <section class="py-8 px-8 md:px-16 lg:px-20 xl:px-40">
        <h1 class="font-serif text-3xl">{Content.frontmatter.title}</h1>
        <div class="prose leading-relaxed">
          <Fragment set:html={compiled} />
        </div>
      </section>
                <div class="mb-5 flex justify-center">
        <button
          type="button"
          class="px-6 py-4 rounded-xl bg-dacBlue-800 text-white text-1xl hover:bg-dacRed-800 hover:scale-110"
          onclick="window.location.href='/sociology'"
          >The Sociology Of Design</button
        >
      </div>
    </Layout>

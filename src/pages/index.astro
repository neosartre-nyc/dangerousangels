---
import Layout from "../layouts/Layout.astro";
import LoadingScreen from "../components/LoadingScreen.astro";
import Button from "../components/PairButton.astro"
import { getCollection, render } from "astro:content"

const posts = [...await getCollection('story')]
  .filter(({ data }) => data.draft !== true)
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

const renderedPosts = await Promise.all(
  posts.map(async (post) => {
    const { Content } = await render(post);
    return {
      ...post,
      Content,
    };
  })
);
---
<main class="bg-dacBlue-950  text-dacSage-50">
  
<Layout>
  <div class="snap-container">
    <!-- Section 1: Hero -->
    <section id="hero" class="snap-section relative min-h-screen">
      <LoadingScreen />
      <div class="mt-24 mx-auto max-w-3xl px-4 sm:px-6 lg:px-8" >
        <hr class="mt-14 border-t border-dacRed-600" />
      </div>

    </section>
  </div>
  <div class="space-y-16">
    <!-- Section 2: Story Posts -->
    <section id="story" class="snap-section relative min-h-screen">
      {renderedPosts.map(({ data, Content },index) => (
        <article class="prose !prose-invert mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 mb-16">
          <Content />
          <div class="pt-4">
          <Button />
          </div>
          {index < renderedPosts.length - 1 && (
        <hr class="mt-12 border-t border-dacRed-600" />
      )}
        </article>
      ))}
    </section>   
    </div>
</Layout>
</main>

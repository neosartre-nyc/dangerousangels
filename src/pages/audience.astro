---
import * as Content from "../content/2026-09-28-audienceRelationship.md";
const compiled = await Content.compiledContent();
import Layout from "../layouts/Layout.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Audience Relationships</title>
  </head>
  <body>
    <Layout>
      <section class="p-8 md:p-16 lg:p-20 xl:p-40">
        <h1 class="font-serif text-3xl">{Content.frontmatter.title}</h1>
        <div class="prose leading-relaxed">
          <Fragment set:html={compiled} />
        </div>
      </section>
      <div class="mb-5 flex justify-center">
        <button
          type="button"
          class="px-6 py-4 rounded-xl bg-dacBlue-800 text-white text-2xl hover:bg-dacRed-800"
          onclick="window.location.href='/sociology'"
          >The Tools and Methods</button
        >
      </div>
    </Layout>
  </body>
</html>

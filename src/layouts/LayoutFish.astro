---
import { Image } from "astro:assets";
import NavigationMenu from "../components/NavigationMenu.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import Background from "../assets/images/dac-crowdedFish.webp"

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
  <head> </head>

  <body class="min-h-dvh flex flex-col"]>
    <NavigationMenu fixed />
    <main style={`background-image: url(${Background.src}); width: screen;
  height: auto;`}>
      <article>
          <div class="title">
            <h1>{title}</h1>
            <hr />
          </div>
          <slot />
      </article>
    </main>
    <Footer />
  </body>
</html>
<img src="/src/assets/images" alt="">
